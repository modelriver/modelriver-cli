{
  "name": "@modelriver/cli",
  "version": "2.0.0",
  "description": "ModelRiver CLI for testing webhooks, WebSockets and hosted tools from production",
  "main": "src/index.js",
  "bin": {
    "modelriver": "bin/modelriver"
  },
  "scripts": {
    "start": "node bin/modelriver",
    "test": "jest"
  },
  "keywords": [
    "modelriver",
    "cli",
    "webhook",
    "websocket",
    "testing",
    "ai",
    "llm",
    "api",
    "tools",
    "tool-calling"
  ],
  "author": "ModelRiver",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modelriver/modelriver-cli.git"
  },
  "homepage": "https://modelriver.com",
  "bugs": {
    "url": "https://github.com/modelriver/modelriver-cli/issues"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "chalk": "^6.0.1",
    "commander": "^15.1.0",
    "express": "^5.3.0",
    "ora": "^10.0.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "jest": "^30.5.2"
  },
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "bin/",
    "src/",
    "tool-signature.js",
    "README.md",
    "!src/**/*.test.js",
    "!**/*.test.js"
  ],
  "jest": {
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^chalk$": "<rootDir>/test/support/chalk.js",
      "^ora$": "<rootDir>/test/support/ora.js"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/test/support/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/support/isolate-home.js"
    ]
  }
}
